REE DOT LOADING\r\n    // ==========================================\r\n\r\n    private void startLoginLoading() {\r\n\r\n        loginButton.setEnabled(false);\r\n\r\n        loginButton.setVisibility(View.GONE);\r\n\r\n        loginProgress.setVisibility(View.VISIBLE);\r\n\r\n        animateDots();\r\n    }\r\n\r\n    // ==========================================\r\n    // STOP THREE DOT LOADING\r\n    // ==========================================\r\n\r\n    private void stopLoginLoading() {\r\n\r\n        loginButton.setEnabled(true);\r\n\r\n        loginButton.setVisibility(View.VISIBLE);\r\n\r\n        loginProgress.setVisibility(View.GONE);\r\n    }\r\n\r\n    // ==========================================\r\n    // THREE DOT ANIMATION\r\n    // ==========================================\r\n\r\n    private void animateDots() {\r\n\r\n        dot1.animate()\r\n                .alpha(0.3f)\r\n                .setDuration(300)\r\n                .withEndAction(() -> {\r\n\r\n                    dot1.animate()\r\n                            .alpha(1f)\r\n                            .setDuration(300)\r\n                            .start();\r\n\r\n                })\r\n                .start();\r\n\r\n        dot2.animate()\r\n                .alpha(0.3f)\r\n                .setStartDelay(200)\r\n                .setDuration(300)\r\n                .withEndAction(() -> {\r\n\r\n                    dot2.animate()\r\n                            .alpha(1f)\r\n                            .setDuration(300)\r\n                            .start();\r\n\r\n                })\r\n                .start();\r\n\r\n        dot3.animate()\r\n                .alpha(0.3f)\r\n                .setStartDelay(400)\r\n                .setDuration(300)\r\n                .withEndAction(() -> {\r\n\r\n                    dot3.animate()\r\n                            .alpha(1f)\r\n                            .setDuration(300)\r\n                            .start();\r\n\r\n                