-<+>package com.example.login;\r\n\r\nimport android.content.Context;\r\nimport android.net.Uri;\r\nimport android.os.Bundle;\r\nimport android.view.View;\r\nimport android.view.ViewGroup;\r\nimport android.view.inputmethod.InputMethodManager;\r\nimport android.widget.EditText;\r\nimport android.widget.ImageButton;\r\nimport android.widget.TextView;\r\nimport android.widget.Toast;\r\n\r\nimport androidx.activity.EdgeToEdge;\r\nimport androidx.activity.result.ActivityResultLauncher;\r\nimport androidx.activity.result.contract.ActivityResultContracts;\r\nimport androidx.appcompat.app.AlertDialog;\r\nimport androidx.appcompat.app.AppCompatActivity;\r\nimport androidx.core.graphics.Insets;\r\nimport androidx.core.view.ViewCompat;\r\nimport androidx.core.view.WindowInsetsCompat;\r\nimport androidx.recyclerview.widget.LinearLayoutManager;\r\nimport androidx.recyclerview.widget.RecyclerView;\r\n\r\nimport com.cloudinary.android.MediaManager;\r\nimport com.cloudinary.android.callback.ErrorInfo;\r\nimport com.cloudinary.android.callback.UploadCallback;\r\nimport com.google.firebase.auth.FirebaseAuth;\r\nimport com.google.firebase.firestore.DocumentSnapshot;\r\nimport com.google.firebase.firestore.FirebaseFirestore;\r\nimport com.google.firebase.firestore.Query;\r\nimport com.google.firebase.firestore.SetOptions;\r\n\r\nimport java.util.ArrayList;\r\nimport java.util.HashMap;\r\nimport java.util.List;\r\nimport java.util.Map;\r\n\r\npublic class ChatActivity extends AppCompatActivity {\r\n\r\n    // ==================================================\r\n    // UI\r\n    // ==================================================\r\n\r\n    private TextView chatUserName;\r\n    private TextView chatStatus;\r\n\r\n    private ImageButton backButton;\r\n    private ImageButton photoButton;\r\n    private ImageButton sendButton;\r\n\r\n    private EditText messageEditText;\r\n\r\n    private RecyclerView messageRecyclerView;\r\n\r\n    // ==================================================\r\n    // FIREBASE\r\n    // ==================================================\r\n\r\n    private FirebaseAuth mAuth;\r\n    private FirebaseFirestore db;\r\n\r\n    // ==================================================\r\n    // CHAT DATA\r\n    // ==================================================\r\n\r\n    private String currentUserId;\r\n    private String receiverId;\r\n    private String receiverUsername;\r\n    private String chatId;\r\n\r\n    // ==================================================\r\n    // MESSAGE DATA\r\n    // ==================================================\r\n\r\n    private List<Message> messageList;\r\n    private MessageAdapter messageAdapter;\r\n\r\n    // ==================================================\r\n    // MEDIA\r\n    // ==================================================\r\n\r\n    private Uri selectedMediaUri;\r\n    private String selectedMediaType = \"\";\r\n\r\n    // ==================================================\r\n    // TEMP UPLOAD\r\n    // ==================================================\r\n\r\n    private Message uploadingMessage;\r\n\r\n    // ==================================================\r\n    // CLOUDINARY\r\n    // ==================================================\r\n\r\n    private static final String CLOUD_NAME =\r\n            \"klhzpjaj\";\r\n\r\n    private static final String UPLOAD_PRESET =\r\n            \"frenzo_media\";\r\n\r\n    private static boolean cloudinaryInitialized =\r\n            false;\r\n\r\n    // ==================================================\r\n    // PHOTO PICKER\r\n    // ==================================================\r\n\r\n    private final ActivityResultLauncher<String>\r\n            photoPicker =\r\n            registerForActivityResult(\r\n                    new ActivityResultContracts.GetContent(),\r\n                    uri -> {\r\n\r\n                        if (uri == null) {\r\n                            return;\r\n                        }\r\n\r\n                        selectedMediaUri =\r\n                                uri;\r\n\r\n                        selectedMediaType =\r\n                                \"image\";\r\n\r\n                        messageEditText.setText(\"\");\r\n\r\n                        messageEditText.setHint(\r\n                                \"Photo selected • Press Send\"\r\n                        );\r\n\r\n                        messageEditText.requestFocus();\r\n                    }\r\n            );\r\n\r\n    // ==================================================\r\n    // VIDEO PICKER\r\n    // ==================================================\r\n\r\n    private final ActivityResultLauncher<String>\r\n            videoPicker =\r\n            registerForActivityResult(\r\n                    new ActivityResultContracts.GetContent(),\r\n                    uri -> {\r\n\r\n                        if (uri == null) {\r\n                            return;\r\n                        }\r\n\r\n                        selectedMediaUri =\r\n                                uri;\r\n\r\n                        selectedMediaType =\r\n                                \"video\";\r\n\r\n                        messageEditText.setText(\"\");\r\n\r\n                        messageEditText.setHint(\r\n                                \"Video selected • Press Send\"\r\n                        );\r\n\r\n                        messageEditText.requestFocus();\r\n                    }\r\n            );\r\n\r\n    // ==================================================\r\n    // ON CREATE\r\n    // ==================================================\r\n\r\n    @Override\r\n    protected void onCreate(\r\n            Bundle savedInstanceState\r\n    ) {\r\n\r\n        super.onCreate(\r\n                savedInstanceState\r\n        );\r\n\r\n        EdgeToEdge.enable(\r\n                this\r\n        );\r\n\r\n        setContentView(\r\n                R.layout.activity_chat\r\n        );\r\n\r\n        // ==================================================\r\n        // FIREBASE\r\n        // ==================================================\r\n\r\n        mAuth =\r\n                FirebaseAuth.getInstance();\r\n\r\n        db =\r\n                FirebaseFirestore.getInstance();\r\n\r\n        if (\r\n                mAuth.getCurrentUser() == null\r\n        ) {\r\n\r\n            finish();\r\n            return;\r\n        }\r\n\r\n        currentUserId =\r\n                mAuth.getCurrentUser()\r\n                        .getUid();\r\n\r\n        // ==================================================\r\n        // RECEIVE USER\r\n        // ==================================================\r\n\r\n        receiverId =\r\n                getIntent().getStringExtra(\r\n                        \"receiverId\"\r\n                );\r\n\r\n        receiverUsername =\r\n                getIntent().getStringExtra(\r\n                        \"receiverUsername\"\r\n                );\r\n\r\n        if (\r\n                receiverId == null ||\r\n                        receiverId.isEmpty()\r\n        ) {\r\n\r\n            Toast.makeText(\r\n                    this,\r\n                    \"User information missing\",\r\n                    Toast.LENGTH_SHORT\r\n            ).show();\r\n\r\n            finish();\r\n            return;\r\n        }\r\n\r\n        if (\r\n                receiverUsername == null ||\r\n                        receiverUsername.isEmpty()\r\n        ) {\r\n\r\n            receiverUsername =\r\n                    \"User\";\r\n        }\r\n\r\n        // ==================================================\r\n        // CHAT ID\r\n        // ==================================================\r\n\r\n        chatId =\r\n                createChatId(\r\n                        currentUserId,\r\n                        receiverId\r\n                );\r\n\r\n        // ==================================================\r\n        // FIND VIEWS\r\n        // ==================================================\r\n\r\n        chatUserName =\r\n                findViewById(\r\n                        R.id.chatUserName\r\n                );\r\n\r\n        chatStatus =\r\n                findViewById(\r\n                        R.id.chatStatus\r\n                );\r\n\r\n        backButton =\r\n                findViewById(\r\n                        R.id.backButton\r\n                );\r\n\r\n        photoButton =\r\n                findViewById(\r\n                        R.id.photoButton\r\n                );\r\n\r\n        sendButton =\r\n                findViewById(\r\n                        R.id.sendButton\r\n                );\r\n\r\n        messageEditText =\r\n                findViewById(\r\n                        R.id.messageEditText\r\n                );\r\n\r\n        messageRecyclerView =\r\n                findViewById(\r\n                        R.id.messageRecyclerView\r\n                );\r\n\r\n        // ==================================================\r\n        // HEADER\r\n        // ==================================================\r\n\r\n        chatUserName.setText(\r\n                receiverUsername\r\n        );\r\n\r\n        chatStatus.setText(\r\n                \"@\" + receiverUsername\r\n        );\r\n\r\n        // ==================================================\r\n        // MESSAGE LIST\r\n        // ==================================================\r\n\r\n        messageList =\r\n                new ArrayList<>();\r\n\r\n        // IMPORTANT:\r\n        // currentUserId is passed directly to adapter.\r\n        messageAdapter =\r\n                new MessageAdapter(\r\n                        messageList,\r\n                        currentUserId,\r\n                        message ->\r\n                                showUnsendConfirmation(\r\n                                        message\r\n                                )\r\n                );\r\n\r\n        LinearLayoutManager layoutManager =\r\n                new LinearLayoutManager(\r\n                        this\r\n                );\r\n\r\n        layoutManager.setStackFromEnd(\r\n                true\r\n        );\r\n\r\n        messageRecyclerView.setLayoutManager(\r\n                layoutManager\r\n        );\r\n\r\n        messageRecyclerView.setAdapter(\r\n                messageAdapter\r\n        );\r\n\r\n        // ==================================================\r\n        // CLOUDINARY\r\n        // ==================================================\r\n\r\n        initializeCloudinary();\r\n\r\n        // ==================================================\r\n        // BACK\r\n        // ==================================================\r\n\r\n        backButton.setOnClickListener(\r\n                v -> {\r\n\r\n                    hideKeyboard();\r\n\r\n                    finish();\r\n                }\r\n        );\r\n\r\n        // ==================================================\r\n        // MEDIA\r\n        // ==================================================\r\n\r\n        photoButton.setOnClickListener(\r\n                v ->\r\n                        showMediaChooser()\r\n        );\r\n\r\n        // ==================================================\r\n        // SEND\r\n        // ==================================================\r\n\r\n        sendButton.setOnClickListener(\r\n                v ->\r\n                        sendCurrentContent()\r\n        );\r\n\r\n        // ==================================================\r\n        // ENTER\r\n        // ==================================================\r\n\r\n        messageEditText.setOnEditorActionListener(\r\n                (v, actionId, event) -> {\r\n\r\n                    sendCurrentContent();\r\n\r\n                    return true;\r\n                }\r\n        );\r\n\r\n        // ==================================================\r\n        // MESSAGE LISTENER\r\n        // ==================================================\r\n\r\n        listenForMessages();\r\n\r\n        // ==================================================\r\n        // INSETS\r\n        // ==================================================\r\n\r\n        setupWindowInsets();\r\n    }\r\n\r\n    // ==================================================\r\n    // WINDOW INSETS\r\n    // ==================================================\r\n\r\n    private void setupWindowInsets() {\r\n\r\n        View root =\r\n                findViewById(\r\n                        R.id.chatRoot\r\n                );\r\n\r\n        View header =\r\n                findViewById(\r\n                        R.id.chatHeader\r\n                );\r\n\r\n        View inputContainer =\r\n                findViewById(\r\n                        R.id.messageInputContainer\r\n                );\r\n\r\n        ViewCompat.setOnApplyWindowInsetsListener(\r\n                root,\r\n                (view, windowInsets) -> {\r\n\r\n                    Insets systemBars =\r\n                            windowInsets.getInsets(\r\n                                    WindowInsetsCompat.Type\r\n                                            .systemBars()\r\n                            );\r\n\r\n                    Insets cutout =\r\n                            windowInsets.getInsets(\r\n                                    WindowInsetsCompat.Type\r\n                                            .displayCutout()\r\n                            );\r\n\r\n                    Insets ime =\r\n                            windowInsets.getInsets(\r\n                                    WindowInsetsCompat.Type\r\n                                            .ime()\r\n                            );\r\n\r\n                    boolean keyboardVisible =\r\n                            windowInsets.isVisible(\r\n                                    WindowInsetsCompat.Type\r\n                                            .ime()\r\n                            );\r\n\r\n                    int safeTop =\r\n                            Math.max(\r\n                                    systemBars.top,\r\n                                    cutout.top\r\n                            );\r\n\r\n                    int safeBottom;\r\n\r\n                    if (keyboardVisible) {\r\n\r\n                        safeBottom =\r\n                                Math.max(\r\n                                        ime.bottom,\r\n                                        systemBars.bottom\r\n                                );\r\n\r\n                    } else {\r\n\r\n                        safeBottom =\r\n                                Math.max(\r\n                                        systemBars.bottom,\r\n                                        cutout.bottom\r\n                                );\r\n                    }\r\n\r\n                    // ==================================================\r\n                    // HEADER\r\n                    // ==================================================\r\n\r\n                    ViewGroup.LayoutParams\r\n                            rawHeaderParams =\r\n                            header.getLayoutParams();\r\n\r\n                    if (\r\n                            rawHeaderParams\r\n                                    instanceof\r\n                                    ViewGroup.MarginLayoutParams\r\n                    ) {\r\n\r\n                        ViewGroup.MarginLayoutParams\r\n                                headerParams =\r\n                                (ViewGroup.MarginLayoutParams)\r\n                                        rawHeaderParams;\r\n\r\n                        headerParams.topMargin =\r\n                                safeTop;\r\n\r\n                        header.setLayoutParams(\r\n                                headerParams\r\n                        );\r\n                    }\r\n\r\n                    // ==================================================\r\n                    // INPUT\r\n                    // ==================================================\r\n\r\n                    ViewGroup.LayoutParams\r\n                            rawInputParams =\r\n                            inputContainer.getLayoutParams();\r\n\r\n                    if (\r\n                            rawInputParams\r\n                                    instanceof\r\n                                    ViewGroup.MarginLayoutParams\r\n                    ) {\r\n\r\n                        ViewGroup.MarginLayoutParams\r\n                                inputParams =\r\n                                (ViewGroup.MarginLayoutParams)\r\n                                        rawInputParams;\r\n\r\n                        inputParams.bottomMargin =\r\n                                safeBottom;\r\n\r\n                        inputContainer.setLayoutParams(\r\n                                inputParams\r\n                        );\r\n                    }\r\n\r\n                    return windowInsets;\r\n                }\r\n        );\r\n\r\n        ViewCompat.requestApplyInsets(\r\n                root\r\n        );\r\n    }\r\n\r\n    // ==================================================\r\n    // CLOUDINARY INIT\r\n    // ==================================================\r\n\r\n    private void initializeCloudinary() {\r\n\r\n        if (cloudinaryInitialized) {\r\n            return;\r\n        }\r\n\r\n        try {\r\n\r\n            Map<String, Object> config =\r\n                    new HashMap<>();\r\n\r\n            config.put(\r\n                    \"cloud_name\",\r\n                    CLOUD_NAME\r\n            );\r\n\r\n            config.put(\r\n                    \"secure\",\r\n                    true\r\n            );\r\n\r\n            MediaManager.init(\r\n                    getApplicationContext(),\r\n                    config\r\n            );\r\n\r\n            cloudinaryInitialized =\r\n                    true;\r\n\r\n        } catch (Exception e) {\r\n\r\n            cloudinaryInitialized =\r\n                    true;\r\n        }\r\n    }\r\n\r\n    // ==================================================\r\n    // MEDIA CHOOSER\r\n    // ==================================================\r\n\r\n    private void showMediaChooser() {\r\n\r\n        String[] options =\r\n                {\r\n                        \"\uD83D\uDCF7  Photo\",\r\n                        \"\uD83C\uDFA5  Video\"\r\n                };\r\n\r\n        new AlertDialog.Builder(\r\n                this\r\n        )\r\n                .setTitle(\r\n                        \"Choose media\"\r\n                )\r\n                .setItems(\r\n                        options,\r\n                        (dialog, which) -> {\r\n\r\n                            if (which == 0) {\r\n\r\n                                photoPicker.launch(\r\n                                        \"image/*\"\r\n                                );\r\n\r\n                            } else {\r\n\r\n                                videoPicker.launch(\r\n                                        \"video/*\"\r\n                                );\r\n                            }\r\n                        }\r\n                )\r\n                .setNegativeButton(\r\n                        \"Cancel\",\r\n                        null\r\n                )\r\n                .show();\r\n    }\r\n\r\n    // ==================================================\r\n    // SEND CURRENT\r\n    // ==================================================\r\n\r\n    private void sendCurrentContent() {\r\n\r\n        if (selectedMediaUri != null) {\r\n\r\n            uploadMediaToCloudinary();\r\n\r\n            return;\r\n        }\r\n\r\n        sendMessage();\r\n    }\r\n\r\n    // ==================================================\r\n    // SEND TEXT\r\n    // ==================================================\r\n\r\n    private void sendMessage() {\r\n\r\n        String text =\r\n                messageEditText\r\n                        .getText()\r\n                        .toString()\r\n                        .trim();\r\n\r\n        if (text.isEmpty()) {\r\n\r\n            messageEditText.setError(\r\n                    \"Write a message\"\r\n            );\r\n\r\n            messageEditText.requestFocus();\r\n\r\n            return;\r\n        }\r\n\r\n        String messageId =\r\n                db.collection(\"chats\")\r\n                        .document(chatId)\r\n                        .collection(\"messages\")\r\n                        .document()\r\n                        .getId();\r\n\r\n        Message message =\r\n                new Message(\r\n                        messageId,\r\n                        currentUserId,\r\n                        receiverId,\r\n                        text,\r\n                        System.currentTimeMillis(),\r\n                        \"sent\"\r\n                );\r\n\r\n        db.collection(\"chats\")\r\n                .document(chatId)\r\n                .collection(\"messages\")\r\n                .document(messageId)\r\n                .set(message)\r\n                .addOnSuccessListener(\r\n                        unused -> {\r\n\r\n                            updateChatSummary(\r\n                                    message\r\n                            );\r\n\r\n                            messageEditText.setText(\r\n                                    \"\"\r\n                            );\r\n\r\n                            messageEditText.setHint(\r\n                                    \"Write a message...\"\r\n                            );\r\n\r\n                            messageEditText.requestFocus();\r\n                        }\r\n                )\r\n                .addOnFailureListener(\r\n                        e ->\r\n                                messageEditText.setError(\r\n                                        \"Message could not be sent\"\r\n                                )\r\n                );\r\n    }\r\n\r\n    // ==================================================\r\n    // SHOW TEMPORARY UPLOAD BUBBLE\r\n    // ==================================================\r\n\r\n    private void showUploadingBubble() {\r\n\r\n        String tempId =\r\n                \"upload_\" +\r\n                        System.currentTimeMillis();\r\n\r\n        uploadingMessage =\r\n                new Message(\r\n                        tempId,\r\n                        currentUserId,\r\n                        receiverId,\r\n                        \"\",\r\n                        selectedMediaUri != null\r\n                                ? selectedMediaUri.toString()\r\n                                : \"\",\r\n                        selectedMediaType,\r\n                        System.currentTimeMillis(),\r\n                        \"sending\"\r\n                );\r\n\r\n        uploadingMessage.setUploading(\r\n                true\r\n        );\r\n\r\n        uploadingMessage.setUploadProgress(\r\n                0\r\n        );\r\n\r\n        messageList.add(\r\n                uploadingMessage\r\n        );\r\n\r\n        messageAdapter.notifyItemInserted(\r\n                messageList.size() - 1\r\n        );\r\n\r\n        messageRecyclerView.post(\r\n                () ->\r\n                        messageRecyclerView.scrollToPosition(\r\n                                messageList.size() - 1\r\n                        )\r\n        );\r\n    }\r\n\r\n    // ==================================================\r\n    // UPDATE UPLOAD PROGRESS\r\n    // ==================================================\r\n\r\n    private void updateUploadingProgress(\r\n            int progress\r\n    ) {\r\n\r\n        if (uploadingMessage == null) {\r\n            return;\r\n        }\r\n\r\n        uploadingMessage.setUploadProgress(\r\n                progress\r\n        );\r\n\r\n        int index =\r\n                messageList.indexOf(\r\n                        uploadingMessage\r\n                );\r\n\r\n        if (index != -1) {\r\n\r\n            messageAdapter.notifyItemChanged(\r\n                    index\r\n            );\r\n        }\r\n    }\r\n\r\n    // ==================================================\r\n    // REMOVE UPLOAD BUBBLE\r\n    // ==================================================\r\n\r\n    private void removeUploadingBubble() {\r\n\r\n        if (uploadingMessage == null) {\r\n            return;\r\n        }\r\n\r\n        int index =\r\n                messageList.indexOf(\r\n                        uploadingMessage\r\n                );\r\n\r\n        if (index != -1) {\r\n\r\n            messageList.remove(\r\n                    index\r\n            );\r\n\r\n            messageAdapter.notifyItemRemoved(\r\n                    index\r\n            );\r\n        }\r\n\r\n        uploadingMessage =\r\n                null;\r\n    }\r\n\r\n    // ==================================================\r\n    // UPLOAD MEDIA\r\n    // ==================================================\r\n\r\n    private void uploadMediaToCloudinary() {\r\n\r\n        if (\r\n                selectedMediaUri == null ||\r\n                        selectedMediaType.isEmpty()\r\n        ) {\r\n            return;\r\n        }\r\n\r\n        final Uri uploadUri =\r\n                selectedMediaUri;\r\n\r\n        final String uploadType =\r\n                selectedMediaType;\r\n\r\n        showUploadingBubble();\r\n\r\n        sendButton.setEnabled(\r\n                false\r\n        );\r\n\r\n        photoButton.setEnabled(\r\n                false\r\n        );\r\n\r\n        messageEditText.setEnabled(\r\n                false\r\n        );\r\n\r\n        messageEditText.setHint(\r\n                \"Media uploading...\"\r\n        );\r\n\r\n        MediaManager.get()\r\n                .upload(\r\n                        uploadUri\r\n                )\r\n                .unsigned(\r\n                        UPLOAD_PRESET\r\n                )\r\n\r\n                .callback(\r\n                        new UploadCallback() {\r\n\r\n                            @Override\r\n                            public void onStart(\r\n                                    String requestId\r\n                            ) {\r\n                            }\r\n\r\n                            @Override\r\n                            public void onProgress(\r\n                                    String requestId,\r\n                                    long bytes,\r\n                                    long totalBytes\r\n                            ) {\r\n\r\n                                if (totalBytes <= 0) {\r\n                                    return;\r\n                                }\r\n\r\n                                int percent =\r\n                                        (int)\r\n                                                (\r\n                                                        bytes * 100\r\n                                                                / totalBytes\r\n                                                );\r\n\r\n                                runOnUiThread(\r\n                                        () ->\r\n                                                updateUploadingProgress(\r\n                                                        percent\r\n                                                )\r\n                                );\r\n                            }\r\n\r\n                            @Override\r\n                            public void onSuccess(\r\n                                    String requestId,\r\n                                    Map resultData\r\n                            ) {\r\n\r\n                                String mediaUrl =\r\n                                        \"\";\r\n\r\n                                if (resultData != null) {\r\n\r\n                                    Object secureUrl =\r\n                                            resultData.get(\r\n                                                    \"secure_url\"\r\n                                            );\r\n\r\n                                    if (secureUrl != null) {\r\n\r\n                                        mediaUrl =\r\n                                                secureUrl.toString();\r\n                                    }\r\n                                }\r\n\r\n                                final String finalUrl =\r\n                                        mediaUrl;\r\n\r\n                                runOnUiThread(\r\n                                        () -> {\r\n\r\n                                            if (finalUrl.isEmpty()) {\r\n\r\n                                                uploadFailed(\r\n                                                        \"Media URL not received\"\r\n                                                );\r\n\r\n                                                return;\r\n                                            }\r\n\r\n                                            updateUploadingProgress(\r\n                                                    100\r\n                                            );\r\n\r\n                                            saveMediaMessage(\r\n                                                    finalUrl,\r\n                                                    uploadType\r\n                                            );\r\n                                        }\r\n                                );\r\n                            }\r\n\r\n                            @Override\r\n                            public void onError(\r\n                                    String requestId,\r\n                                    ErrorInfo error\r\n                            ) {\r\n\r\n                                String errorText =\r\n                                        \"Upload failed\";\r\n\r\n                                if (\r\n                                        error != null &&\r\n                                                error.getDescription() != null &&\r\n                                                !error.getDescription()\r\n                                                        .isEmpty()\r\n                                ) {\r\n\r\n                                    errorText =\r\n                                            error.getDescription();\r\n                                }\r\n\r\n                                final String finalError =\r\n                                        errorText;\r\n\r\n                                runOnUiThread(\r\n                                        () ->\r\n                                                uploadFailed(\r\n                                                        finalError\r\n                                                )\r\n                                );\r\n                            }\r\n\r\n                            @Override\r\n                            public void onReschedule(\r\n                                    String requestId,\r\n                                    ErrorInfo error\r\n                            ) {\r\n                            }\r\n                        }\r\n                )\r\n                .dispatch();\r\n    }\r\n\r\n    // ==================================================\r\n    // SAVE MEDIA MESSAGE\r\n    // ==================================================\r\n\r\n    private void saveMediaMessage(\r\n            String mediaUrl,\r\n            String mediaType\r\n    ) {\r\n\r\n        String messageId =\r\n                db.collection(\"chats\")\r\n                        .document(chatId)\r\n                        .collection(\"messages\")\r\n                        .document()\r\n                        .getId();\r\n\r\n        Message mediaMessage =\r\n                new Message(\r\n                        messageId,\r\n                        currentUserId,\r\n                        receiverId,\r\n                        \"\",\r\n                        mediaUrl,\r\n                        mediaType,\r\n                        System.currentTimeMillis(),\r\n                        \"sent\"\r\n                );\r\n\r\n        db.collection(\"chats\")\r\n                .document(chatId)\r\n                .collection(\"messages\")\r\n                .document(messageId)\r\n                .set(mediaMessage)\r\n                .addOnSuccessListener(\r\n                        unused -> {\r\n\r\n                            removeUploadingBubble();\r\n\r\n                            updateChatSummary(\r\n                                    mediaMessage\r\n                            );\r\n\r\n                            selectedMediaUri =\r\n                                    null;\r\n\r\n                            selectedMediaType =\r\n                                    \"\";\r\n\r\n                            resetMediaControls();\r\n                        }\r\n                )\r\n                .addOnFailureListener(\r\n                        e -> {\r\n\r\n                            removeUploadingBubble();\r\n\r\n                            selectedMediaUri =\r\n                                    null;\r\n\r\n                            selectedMediaType =\r\n                                    \"\";\r\n\r\n                            resetMediaControls();\r\n\r\n                            Toast.makeText(\r\n                                    this,\r\n                                    \"Media message could not be saved\",\r\n                                    Toast.LENGTH_SHORT\r\n                            ).show();\r\n                        }\r\n                );\r\n    }\r\n\r\n    // ==================================================\r\n    // CHAT SUMMARY\r\n    // ==================================================\r\n\r\n    private void updateChatSummary(\r\n            Message message\r\n    ) {\r\n\r\n        if (\r\n                message == null ||\r\n                        message.isUnsent()\r\n        ) {\r\n            return;\r\n        }\r\n\r\n        Map<String, Object> data =\r\n                new HashMap<>();\r\n\r\n        data.put(\r\n                \"senderId\",\r\n                currentUserId\r\n        );\r\n\r\n        data.put(\r\n                \"receiverId\",\r\n                receiverId\r\n        );\r\n\r\n        data.put(\r\n                \"lastMessageTime\",\r\n                message.getTimestamp()\r\n        );\r\n\r\n        if (\r\n                \"image\".equalsIgnoreCase(\r\n                        message.getMessageType()\r\n                )\r\n        ) {\r\n\r\n            data.put(\r\n                    \"lastMessage\",\r\n                    \"\uD83D\uDCF7 Photo\"\r\n            );\r\n\r\n        } else if (\r\n                \"video\".equalsIgnoreCase(\r\n                        message.getMessageType()\r\n                )\r\n        ) {\r\n\r\n            data.put(\r\n                    \"lastMessage\",\r\n                    \"\uD83C\uDFA5 Video\"\r\n            );\r\n\r\n        } else {\r\n\r\n            data.put(\r\n                    \"lastMessage\",\r\n                    message.getMessage()\r\n            );\r\n        }\r\n\r\n        db.collection(\"chats\")\r\n                .document(chatId)\r\n                .set(\r\n                        data,\r\n                        SetOptions.merge()\r\n                );\r\n    }\r\n\r\n    // ==================================================\r\n    // UNSEND CONFIRMATION\r\n    // ==================================================\r\n\r\n    private void showUnsendConfirmation(\r\n            Message message\r\n    ) {\r\n\r\n        if (message == null) {\r\n            return;\r\n        }\r\n\r\n        if (\r\n                !currentUserId.equals(\r\n                        message.getSenderId()\r\n                )\r\n        ) {\r\n            return;\r\n        }\r\n\r\n        String title =\r\n                \"Unsend message?\";\r\n\r\n        if (\r\n                \"image\".equalsIgnoreCase(\r\n                        message.getMessageType()\r\n                )\r\n        ) {\r\n\r\n            title =\r\n                    \"Unsend photo?\";\r\n\r\n        } else if (\r\n                \"video\".equalsIgnoreCase(\r\n                        message.getMessageType()\r\n                )\r\n        ) {\r\n\r\n            title =\r\n                    \"Unsend video?\";\r\n        }\r\n\r\n        new AlertDialog.Builder(\r\n                this\r\n        )\r\n                .setTitle(\r\n                        title\r\n                )\r\n                .setMessage(\r\n                        \"It will disappear from the chat for both users.\"\r\n                )\r\n                .setNegativeButton(\r\n                        \"Cancel\",\r\n                        null\r\n                )\r\n                .setPositiveButton(\r\n                        \"Unsend\",\r\n                        (dialog, which) ->\r\n                                unsendMessage(\r\n                                        message\r\n                                )\r\n                )\r\n                .show();\r\n    }\r\n\r\n    // ==================================================\r\n    // UNSEND\r\n    // ==================================================\r\n\r\n    private void unsendMessage(\r\n            Message message\r\n    ) {\r\n\r\n        if (\r\n                message == null ||\r\n                        message.getMessageId() == null\r\n        ) {\r\n            return;\r\n        }\r\n\r\n        if (\r\n                !currentUserId.equals(\r\n                        message.getSenderId()\r\n                )\r\n        ) {\r\n            return;\r\n        }\r\n\r\n        db.collection(\"chats\")\r\n                .document(chatId)\r\n                .collection(\"messages\")\r\n                .document(\r\n                        message.getMessageId()\r\n                )\r\n                .update(\r\n                        \"isUnsent\",\r\n                        true\r\n                )\r\n                .addOnSuccessListener(\r\n                        unused ->\r\n                                Toast.makeText(\r\n                                        this,\r\n                                        \"Unsent\",\r\n                                        Toast.LENGTH_SHORT\r\n                                ).show()\r\n                )\r\n                .addOnFailureListener(\r\n                        e ->\r\n                                Toast.makeText(\r\n                                        this,\r\n                                        \"Could not unsend message\",\r\n                                        Toast.LENGTH_SHORT\r\n                                ).show()\r\n                );\r\n    }\r\n\r\n    // ==================================================\r\n    // REALTIME MESSAGE LISTENER\r\n    // ==================================================\r\n\r\n    private void listenForMessages() {\r\n\r\n        db.collection(\"chats\")\r\n                .document(chatId)\r\n                .collection(\"messages\")\r\n                .orderBy(\r\n                        \"timestamp\",\r\n                        Query.Direction.ASCENDING\r\n                )\r\n                .addSnapshotListener(\r\n                        (snapshot, error) -> {\r\n\r\n                            if (error != null) {\r\n\r\n                                Toast.makeText(\r\n                                        this,\r\n                                        \"Could not load chat\",\r\n                                        Toast.LENGTH_SHORT\r\n                                ).show();\r\n\r\n                                return;\r\n                            }\r\n\r\n                            if (snapshot == null) {\r\n                                return;\r\n                            }\r\n\r\n                            messageList.clear();\r\n\r\n                            for (\r\n                                    DocumentSnapshot document :\r\n                                    snapshot.getDocuments()\r\n                            ) {\r\n\r\n                                Message message =\r\n                                        document.toObject(\r\n                                                Message.class\r\n                                        );\r\n\r\n                                if (message == null) {\r\n                                    continue;\r\n                                }\r\n\r\n                                // ==================================================\r\n                                // HIDE UNSENT\r\n                                // ==================================================\r\n\r\n                                if (\r\n                                        message.isUnsent()\r\n                                ) {\r\n                                    continue;\r\n                                }\r\n\r\n                                // ==================================================\r\n                                // MESSAGE RECEIVED FROM OTHER USER\r\n                                // ==================================================\r\n\r\n                                if (\r\n                                        currentUserId != null &&\r\n                                                receiverId != null &&\r\n                                                receiverId.equals(\r\n                                                        message.getSenderId()\r\n                                                )\r\n                                ) {\r\n\r\n                                    String status =\r\n                                            message.getStatus();\r\n\r\n                                    // Since this chat is currently open,\r\n                                    // the message has been seen.\r\n                                    if (\r\n                                            !\"seen\".equalsIgnoreCase(\r\n                                                    status\r\n                                            )\r\n                                    ) {\r\n\r\n                                        markAsSeen(\r\n                                                document.getId()\r\n                                        );\r\n\r\n                                        message.setStatus(\r\n                                                \"seen\"\r\n                                        );\r\n                                    }\r\n                                }\r\n\r\n                                messageList.add(\r\n                                        message\r\n                                );\r\n                            }\r\n\r\n                            // ==================================================\r\n                            // KEEP UPLOAD BUBBLE\r\n                            // ==================================================\r\n\r\n                            if (uploadingMessage != null) {\r\n\r\n                                messageList.add(\r\n                                        uploadingMessage\r\n                                );\r\n                            }\r\n\r\n                            messageAdapter.notifyDataSetChanged();\r\n\r\n                            scrollToLastMessage();\r\n                        }\r\n                );\r\n    }\r\n\r\n    // ==================================================\r\n    // MARK AS SEEN\r\n    // ==================================================\r\n\r\n    private void markAsSeen(\r\n            String messageId\r\n    ) {\r\n\r\n        if (\r\n                messageId == null ||\r\n                        messageId.isEmpty()\r\n        ) {\r\n            return;\r\n        }\r\n\r\n        db.collection(\"chats\")\r\n                .document(chatId)\r\n                .collection(\"messages\")\r\n                .document(messageId)\r\n                .update(\r\n                        \"status\",\r\n                        \"seen\"\r\n                );\r\n    }\r\n\r\n    // ==================================================\r\n    // SCROLL\r\n    // ==================================================\r\n\r\n    private void scrollToLastMessage() {\r\n\r\n        if (\r\n                messageList == null ||\r\n                        messageList.isEmpty() ||\r\n                        messageRecyclerView == null\r\n        ) {\r\n            return;\r\n        }\r\n\r\n        messageRecyclerView.post(\r\n                () ->\r\n                        messageRecyclerView.scrollToPosition(\r\n                                messageList.size() - 1\r\n                        )\r\n        );\r\n    }\r\n\r\n    // ==================================================\r\n    // RESET MEDIA CONTROLS\r\n    // ==================================================\r\n\r\n    private void resetMediaControls() {\r\n\r\n        if (sendButton != null) {\r\n\r\n            sendButton.setEnabled(\r\n                    true\r\n            );\r\n        }\r\n\r\n        if (photoButton != null) {\r\n\r\n            photoButton.setEnabled(\r\n                    true\r\n            );\r\n        }\r\n\r\n        if (messageEditText != null) {\r\n\r\n            messageEditText.setEnabled(\r\n                    true\r\n            );\r\n\r\n            messageEditText.setHint(\r\n                    \"Write a message...\"\r\n            );\r\n\r\n            messageEditText.requestFocus();\r\n        }\r\n    }\r\n\r\n    // ==================================================\r\n    // UPLOAD FAILED\r\n    // ==================================================\r\n\r\n    private void uploadFailed(\r\n            String error\r\n    ) {\r\n\r\n        removeUploadingBubble();\r\n\r\n        selectedMediaUri =\r\n                null;\r\n\r\n        selectedMediaType =\r\n                \"\";\r\n\r\n        resetMediaControls();\r\n\r\n        Toast.makeText(\r\n                this,\r\n                error,\r\n                Toast.LENGTH_LONG\r\n        ).show();\r\n    }\r\n\r\n    // ==================================================\r\n    // CREATE CHAT ID\r\n    // ==================================================\r\n\r\n    private String createChatId(\r\n            String user1,\r\n            String user2\r\n    ) {\r\n\r\n        if (\r\n                user1.compareTo(\r\n                        user2\r\n                ) < 0\r\n        ) {\r\n\r\n            return user1 +\r\n                    \"_\" +\r\n                    user2;\r\n        }\r\n\r\n        return user2 +\r\n                \"_\" +\r\n                user1;\r\n    }\r\n\r\n    // ==================================================\r\n    // HIDE KEYBOARD\r\n    // ==================================================\r\n\r\n    private void hideKeyboard() {\r\n\r\n        InputMethodManager imm =\r\n                (InputMethodManager)\r\n                        getSystemService(\r\n                                Context.INPUT_METHOD_SERVICE\r\n                        );\r\n\r\n        View currentFocus =\r\n                getCurrentFocus();\r\n\r\n        if (\r\n                imm != null &&\r\n                        currentFocus != null\r\n        ) {\r\n\r\n            imm.hideSoftInputFromWindow(\r\n                    currentFocus.getWindowToken(),\r\n                    0\r\n            );\r\n        }\r\n    }\r\n\r\n    // ===========