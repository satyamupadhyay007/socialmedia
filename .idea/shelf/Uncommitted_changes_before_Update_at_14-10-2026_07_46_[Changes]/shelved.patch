==\r\n\r\n            db.collection(\"usernames\")\r\n                    .document(userIdKey)\r\n                    .get()\r\n                    .addOnSuccessListener(usernameDocument -> {\r\n\r\n                        // ==================================\r\n                        // USER ID NOT FOUND\r\n                        // ==================================\r\n\r\n                        if (!usernameDocument.exists()) {\r\n\r\n                            stopLoginLoading();\r\n\r\n                            username.setError(\r\n                                    \"User ID not found\"\r\n                            );\r\n\r\n                            username.requestFocus();\r\n\r\n                            return;\r\n                        }\r\n\r\n                        // ==================================\r\n                        // FIREBASE UID\r\n                        // ==================================\r\n\r\n                        String authUid =\r\n                                usernameDocument\r\n                                        .getString(\"uid\");\r\n\r\n                        if (authUid == null ||\r\n                                authUid.isEmpty()) {\r\n\r\n                            stopLoginLoading();\r\n\r\n                            username.setError(\r\n                                    \"Account data is incomplete\"\r\n                            );\r\n\r\n                            username.requestFocus();\r\n\r\n                            return;\r\n                        }\r\n\r\n                        // ==================================\r\n                        // NEW ACCOUNT\r\n                        //\r\n                        // usernames/{userId}/email\r\n                        // ==================================\r\n\r\n                        String email =\r\n                                usernameDocument\r\n                                        .getString(\"email\");\r\n\