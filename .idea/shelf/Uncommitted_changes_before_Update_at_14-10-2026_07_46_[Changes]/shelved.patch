===================================\r\n    // ROOT\r\n    // ==================================================\r\n\r\n    private View profileRoot;\r\n    private View bottomNavigation;\r\n\r\n    // ==================================================\r\n    // ON CREATE\r\n    // ==================================================\r\n\r\n    @Override\r\n    protected void onCreate(\r\n            Bundle savedInstanceState\r\n    ) {\r\n\r\n        super.onCreate(\r\n                savedInstanceState\r\n        );\r\n\r\n        setContentView(\r\n                R.layout.activity_profile\r\n        );\r\n\r\n        // ==================================================\r\n        // FIND PROFILE VIEWS\r\n        // ==================================================\r\n\r\n        btnBack =\r\n                findViewById(\r\n                        R.id.btnBack\r\n                );\r\n\r\n        btnSettings =\r\n                findViewById(\r\n                        R.id.btnSettings\r\n                );\r\n\r\n        tvName =\r\n                findViewById(\r\n                        R.id.tvName\r\n                );\r\n\r\n        tvUsername =\r\n                findViewById(\r\n                        R.id.tvUsername\r\n                );\r\n\r\n        tvBio =\r\n                findViewById(\r\n                        R.id.tvBio\r\n                );\r\n\r\n        btnEditProfile =\r\n                findViewById(\r\n                        R.id.btnEditProfile\r\n                );\r\n\r\n        // ==================================================\r\n        // TABS\r\n        // ==================================================\r\n\r\n        tabPosts =\r\n                findViewById(\r\n                        R.id.tabPosts\r\n                );\r\n\r\n        tabReels =\r\n                findViewById(\r\n                        R.id.tabReels\r\n                );\r\n\r\n        tabTagged =\r\n                findViewById(\r\n                        R.id.tabTagged\r\n                );\r\n\r\n        // ==================================================\r\n        // POSTS\r\n        // ==================================================\r\n\r\n        recyclerPosts =\r\n                findViewById(\r\n                        R.id.recyclerPosts\r\n                );\r\n\r\n        // ==================================================\r\n        // BOTTOM NAVIGATION\r\n        // ==================================================\r\n\r\n        btnHome =\r\n                findViewById(\r\n                        R.id.btnHome\r\n                );\r\n\r\n        btnCreate =\r\n                findViewById(\r\n                        R.id.btnCreate\r\n                );\r\n\r\n        btnMessage =\r\n                findViewById(\r\n                        R.id.btnMessage\r\n                );\r\n\r\n        btnSearch =\r\n                findViewById(\r\n                        R.id.btnSearch\r\n                );\r\n\r\n        btnProfile =\r\n                findViewById(\r\n                        R.id.btnProfile\r\n                );\r\n\r\n        profileRoot =\r\n                findViewById(\r\n                        R.id.profileRoot\r\n                );\r\n\r\n        bottomNavigation =\r\n                findViewById(\r\n                        R.id.bottomNavigation\r\n                );\r\n\r\n        // ==================================================\r\n        // POST GRID\r\n        // ==================================================\r\n\r\n        recyclerPosts.setLayoutManager(\r\n                new GridLayoutManager(\r\n                        this,\r\n                        3\r\n                )\r\n        );\r\n\r\n        recyclerPosts.setHasFixedSize(\r\n                true\r\n        );\r\n\r\n        // ==================================================\r\n        // CURRENT STATIC POSTS\r\n        // ==================================================\r\n\r\n        List<Integer> images =\r\n                Arrays.asList(\r\n                        R.drawable.post_1,\r\n                        R.drawable.post_2,\r\n                        R.drawable.post_3,\r\n                        R.drawable.post_4,\r\n                        R.drawable.post_5,\r\n                        R.drawable.post_6,\r\n                        R.drawable.post_7,\r\n                        R.drawable.post_8,\r\n                        R.drawable.post_9\r\n                );\r\n\r\n        ProfilePostAdapter adapter =\r\n                new ProfilePostAdapter(\r\n                        images\r\n                );\r\n\r\n        recyclerPosts.setAdapter(\r\n                adapter\r\n        );\r\n\r\n        // ==================================================\r\n        // BACK\r\n        // ==================================================\r\n\r\n        btnBack.setOnClickListener(\r\n                v -> {\r\n\r\n                    hideKeyboard();\r\n\r\n                    finish();\r\n                }\r\n        );\r\n\r\n        // ==================================================\r\n        // SETTINGS\r\n        // ==================================================\r\n\r\n        btnSettings.setOnClickListener(\r\n                v -> showSettings()\r\n        );\r\n\r\n        // ==================================================\r\n        // EDIT PROFILE\r\n        // ==================================================\r\n\r\n        btnEditProfile.setOnClickListener(\r\n                v -> showEditProfile()\r\n        );\r\n\r\n        // ==================================================\r\n        // TABS\r\n        // ==================================================\r\n\r\n        setupTabs();\r\n\r\n        // ==================================================\r\n        // BOTTOM NAVIGATION\r\n        // ==================================================\r\n\r\n        setupBottomNavigation();\r\n\r\n        // ==================================================\r\n        // SAFE AREA\r\n        // ==================================================\r\n\r\n        setupWindowInsets();\r\n    }\r\n\r\n    // ==================================================\r\n    // TABS\r\n    // ==================================================\r\n\r\n    private void setupTabs() {\r\n\r\n        tabPosts.setOnClickListener(\r\n                v -> {\r\n\r\n                    selectTab(\r\n                            tabPosts,\r\n                            tabReels,\r\n                            tabTagged\r\n                    );\r\n\r\n                    recyclerPosts.setVisibility(\r\n                            View.VISIBLE\r\n                    );\r\n                }\r\n        );\r\n\r\n        tabReels.setOnClickListener(\r\n                v -> {\r\n\r\n                    selectTab(\r\n                            tabReels,\r\n                            tabPosts,\r\n                            tabTagged\r\n                    );\r\n\r\n                    Toast.makeText(\r\n                            this,\r\n                            \"Reels section coming soon\",\r\n                            Toast.LENGTH_SHORT\r\n                    ).show();\r\n                }\r\n        );\r\n\r\n        tabTagged.setOnClickListener(\r\n                v -> {\r\n\r\n                    selectTab(\r\n                            tabTagged,\r\n                            tabPosts,\r\n                            tabReels\r\n                    );\r\n\r\n                    Toast.makeText(\r\n                            this,\r\n                            \"Tagged section coming soon\",\r\n                            Toast.LENGTH_SHORT\r\n                    ).show();\r\n                }\r\n        );\r\n\r\n        selectTab(\r\n                tabPosts,\r\n                tabReels,\r\n                tabTagged\r\n        );\r\n    }\r\n\r\n    // ==================================================\r\n    // TAB SELECT\r\n    // ==================================================\r\n\r\n    private void selectTab(\r\n            TextView selected,\r\n            TextView otherOne,\r\n            TextView otherTwo\r\n    ) {\r\n\r\n        selected.setTextColor(\r\n                0xFF111111\r\n        );\r\n\r\n        selected.setTypeface(\r\n                null,\r\n                android.graphics.Typeface.BOLD\r\n        );\r\n\r\n        otherOne.setTextColor(\r\n                0xFF777777\r\n        );\r\n\r\n        otherOne.setTypeface(\r\n                null,\r\n                android.graphics.Typeface.NORMAL\r\n        );\r\n\r\n        otherTwo.setTextColor(\r\n                0xFF777777\r\n        );\r\n\r\n        otherTwo.setTypeface(\r\n                null,\r\n                android.graphics.Typeface.NORMAL\r\n        );\r\n    }\r\n\r\n    // ==================================================\r\n    // SETTINGS\r\n    // ==================================================\r\n\r\n    private void showSettings() {\r\n\r\n        String[] items =\r\n                {\r\n                        \"Account Settings\",\r\n                        \"Privacy\",\r\n                        \"Notifications\",\r\n                        \"Cancel\"\r\n                };\r\n\r\n        new AlertDialog.Builder(\r\n                this\r\n        )\r\n                .setTitle(\r\n                        \"Settings\"\r\n                )\r\n                .setItems(\r\n                        items,\r\n                        (dialog, which) -> {\r\n\r\n                            if (which == 0) {\r\n\r\n                                Toast.makeText(\r\n                                        this,\r\n                                        \"Account Settings coming soon\",\r\n                                        Toast.LENGTH_SHORT\r\n                                ).show();\r\n\r\n                            } else if (which == 1) {\r\n\r\n                   