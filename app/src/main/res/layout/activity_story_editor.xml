<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- =========================================================
         FULL STORY CANVAS
         ========================================================= -->

    <FrameLayout
        android:id="@+id/editorCanvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/storyPreviewImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:contentDescription="Story photo"
            android:scaleType="matrix" />

        <VideoView
            android:id="@+id/storyPreviewVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Subtle readability gradients -->
        <View
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="top"
            android:background="@drawable/story_top_scrim" />

        <View
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_gravity="bottom"
            android:background="@drawable/story_bottom_scrim" />

        <!-- =====================================================
             TOP BAR: SAFE AREA + CONTROLS
             ===================================================== -->

        <LinearLayout
            android:id="@+id/storyTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageButton
                android:id="@+id/btnBackStoryEditor"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/story_circle_button"
                android:contentDescription="Back"
                android:padding="11dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#FFFFFF" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnStoryText"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/story_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Aa"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnStoryMusic"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:background="@drawable/story_circle_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="♫"
                android:textColor="#FFFFFF"
                android:textSize="27sp" />

        </LinearLayout>

        <!-- =====================================================
             DRAGGABLE TEXT
             ===================================================== -->

        <EditText
            android:id="@+id/storyCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:minWidth="80dp"
            android:maxWidth="340dp"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:hint=""
            android:inputType="textCapSentences|textMultiLine"
            android:imeOptions="flagNoExtractUi"
            android:maxLines="6"
            android:textColor="#FFFFFF"
            android:textCursorDrawable="@null"
            android:textSize="30sp"
            android:visibility="gone"
            android:elevation="30dp" />

        <!-- =====================================================
             MUSIC CHIP
             ===================================================== -->

        <TextView
            android:id="@+id/selectedSongText"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="78dp"
            android:background="@drawable/story_music_chip"
            android:ellipsize="marquee"
            android:gravity="center"
            android:maxWidth="290dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- =====================================================
             TEXT EDITING TOOLBAR
             ===================================================== -->

        <LinearLayout
            android:id="@+id/textToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="128dp"
            android:background="@drawable/story_toolbar_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Style"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnStyleClassic"
                    android:layout_width="72dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/story_tool_button"
                    android:gravity="center"
                    android:text="Classic"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnStyleBold"
                    android:layout_width="60dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/story_tool_button"
                    android:gravity="center"
                    android:text="Bold"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnStyleModern"
                    android:layout_width="72dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/story_tool_button"
                    android:gravity="center"
                    android:text="Modern"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/btnDoneText"
                    android:layout_width="52dp"
                    android:layout_height="36dp"
                    android:background="@drawable/story_done_button"
                    android:gravity="center"
                    android:text="Done"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Size"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/textSizeSeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:max="40"
                    android:progress="18" />

                <TextView
                    android:id="@+id/btnTextWhite"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/story_color_white"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnTextYellow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/story_color_yellow"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnTextPink"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/story_color_pink"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

        </LinearLayout>

        <!-- =====================================================
             BOTTOM SHARE AREA
             ===================================================== -->

        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/editorHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:text="Pinch to zoom • Drag to adjust • Tap Aa for text"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnShareStory"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/story_share_button"
                android:text="Share to Story"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
