<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="82dp"

    android:paddingStart="16dp"
    android:paddingEnd="16dp"

    android:background="#F3F1F7"
    android:clickable="true"
    android:focusable="true">


    <!-- ========================================= -->
    <!-- PROFILE IMAGE -->
    <!-- ========================================= -->

    <ImageView
        android:id="@+id/chatUserImage"

        android:layout_width="48dp"
        android:layout_height="48dp"

        android:src="@android:drawable/ic_menu_myplaces"

        android:contentDescription="User"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />


    <!-- ========================================= -->
    <!-- USERNAME -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/chatUserUsername"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"

        android:text="User"

        android:textColor="#25232A"

        android:textSize="17sp"
        android:textStyle="bold"

        android:maxLines="1"
        android:ellipsize="end"

        app:layout_constraintStart_toEndOf="@id/chatUserImage"
        app:layout_constraintEnd_toStartOf="@id/chatMessageTime"
        app:layout_constraintTop_toTopOf="parent"

        android:layout_marginTop="14dp" />


    <!-- ========================================= -->
    <!-- LAST MESSAGE -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/chatUserId"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"

        android:layout_marginTop="3dp"

        android:text="No messages yet"

        android:textColor="#64616C"

        android:textSize="14sp"

        android:maxLines="1"
        android:ellipsize="end"

        app:layout_constraintStart_toEndOf="@id/chatUserImage"
        app:layout_constraintEnd_toStartOf="@id/chatMessageTime"

        app:layout_constraintTop_toBottomOf="@id/chatUserUsername" />


    <!-- ========================================= -->
    <!-- MESSAGE TIME -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/chatMessageTime"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="20:45"

        android:textColor="#787580"

        android:textSize="12sp"

        android:gravity="end"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/chatUserUsername" />


    <!-- ========================================= -->
    <!-- UNREAD COUNT -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/chatUnreadCount"

        android:layout_width="26dp"
        android:layout_height="26dp"

        android:layout_marginTop="6dp"

        android:gravity="center"

        android:text="2"

        android:textColor="#FFFFFF"

        android:textSize="12sp"

        android:textStyle="bold"

        android:background="@drawable/unread_badge"

        android:visibility="gone"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatMessageTime" />


</androidx.constraintlayout.widget.ConstraintLayout>