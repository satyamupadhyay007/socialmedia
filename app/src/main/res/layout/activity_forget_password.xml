<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/whitebg"
    tools:context=".forgetPassword">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="30dp"
        android:backgroundTint="#E7EFE7E7"
        app:cardCornerRadius="30dp"
        app:cardElevation="20dp">

        <LinearLayout
            android:id="@+id/passwordpage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/forgetpassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Forget Password"
                android:textAlignment="center"
                android:textColor="#3956F2"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:ignore="TextSizeCheck" />

            <EditText
                android:id="@+id/recoveryEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:background="@drawable/custom_edit_text"
                android:drawableLeft="@drawable/account"
                android:drawablePadding="16dp"
                android:hint=" Enter Your Registerd Email"
                android:inputType="textEmailAddress"
                android:minHeight="48dp"
                android:padding="8dp"
                android:textColor="@color/black"
                tools:ignore="TouchTargetSizeCheck" />

            <!-- RECOVER BUTTON -->

            <Button
                android:id="@+id/recover"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:backgroundTint="#3956F2"
                android:text="Recover"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:textSize="30dp"
                android:textStyle="bold"
                tools:text="Recover" />

            <!-- THREE DOT PROGRESS -->

            <LinearLayout
                android:id="@+id/recoveryProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/recoveryDot1"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/progress_dot"
                    android:text="" />

                <TextView
                    android:id="@+id/recoveryDot2"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/progress_dot"
                    android:text="" />

                <TextView
                    android:id="@+id/recoveryDot3"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/progress_dot"
                    android:text="" />

            </LinearLayout>

            <!-- SUCCESS / ERROR MESSAGE -->

            <TextView
                android:id="@+id/recoveryMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/signupText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="Back to Login..? "
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="23sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/gotologin"
        android:layout_width="234dp"
        android:layout_height="60dp"
        android:backgroundTint="#0E1E7C"
        android:text="Login"
        android:textSize="23sp"
        android:textColor="@color/white" />

</LinearLayout>