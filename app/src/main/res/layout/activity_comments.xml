<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/commentsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="false">

    <!-- ========================= TOP BAR ========================= -->

    <LinearLayout
        android:id="@+id/commentsHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:background="#000000"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF" />

        <TextView
            android:id="@+id/tvCommentsTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="Comments"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans" />

        <TextView
            android:id="@+id/tvCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:minWidth="64dp"
            android:text="0 comments"
            android:textColor="#A7A7AC"
            android:textSize="13sp"
            android:fontFamily="sans" />

    </LinearLayout>

    <!-- ========================= COMMENTS ========================= -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerComments"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="60dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="4dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/tvNoComments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="No comments yet\nBe the first to comment"
        android:textColor="#85858A"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp" />

    <!-- ========================= REPLY BAR ========================= -->

    <LinearLayout
        android:id="@+id/replyBar"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="76dp"
        android:background="@drawable/comment_reply_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReplyingTo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Replying to @user"
            android:textColor="#B9B9BE"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnCancelReply"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

    </LinearLayout>

    <!-- ========================= COMPOSER ========================= -->

    <LinearLayout
        android:id="@+id/commentComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#000000"
        android:gravity="center_vertical"
        android:minHeight="76dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/editComment"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/comment_input_bg"
            android:fontFamily="sans"
            android:gravity="center_vertical"
            android:hint="Add a comment..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="52dp"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8E93"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/comment_send_bg"
            android:contentDescription="Send comment"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#FFFFFF" />

    </LinearLayout>

</FrameLayout>
