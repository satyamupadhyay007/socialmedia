<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/storyViewerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false">

    <!-- STORY IMAGE -->
    <ImageView
        android:id="@+id/storyImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:contentDescription="Story"
        android:scaleType="fitCenter" />

    <!-- STORY VIDEO -->
    <VideoView
        android:id="@+id/storyVideo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- TOP SCRIM -->
    <View
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="top"
        android:background="@drawable/story_viewer_top_scrim" />

    <!-- BOTTOM SCRIM -->
    <View
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="bottom"
        android:background="@drawable/story_viewer_bottom_scrim" />

    <!-- STORY PROGRESS -->
    <LinearLayout
        android:id="@+id/storyProgressContainer"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal" />

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/storyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <!-- USERNAME -->
        <TextView
            android:id="@+id/storyUsername"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="User"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- STORY COUNT -->
        <TextView
            android:id="@+id/storyCount"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="1/1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- MORE -->
        <ImageButton
            android:id="@+id/btnMoreStory"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/story_viewer_circle"
            android:contentDescription="More options"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_more"
            android:tint="#FFFFFF"
            android:visibility="gone" />

        <!-- VIEW COUNT -->
        <TextView
            android:id="@+id/storyViewCount"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/story_viewer_chip"
            android:gravity="center"
            android:minWidth="55dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="👁 0"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <!-- CLOSE -->
        <ImageButton
            android:id="@+id/btnCloseStory"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/story_viewer_circle"
            android:contentDescription="Close"
            android:padding="11dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- CAPTION -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/storyCaptionOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="150dp"
        android:background="@drawable/story_caption_viewer_bg"
        android:gravity="center"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold"
        android:visibility="gone" />


    <!-- ===================================================== -->
    <!-- MUSIC -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/storyMusicOverlay"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="100dp"
        android:background="@drawable/story_music_chip"
        android:ellipsize="marquee"
        android:gravity="center"
        android:maxWidth="300dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone" />


    <!-- ===================================================== -->
    <!-- STORY LIKE - INSTAGRAM STYLE -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/storyLikeContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="25dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- LIKE BUTTON -->
        <ImageButton
            android:id="@+id/btnLikeStory"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/story_viewer_circle"
            android:contentDescription="Like story"
            android:padding="11dp"
            android:src="@android:drawable/btn_star_big_off"
            android:tint="#FFFFFF" />

        <!-- LIKE COUNT
             Java me owner ke liye visible hoga.
             Normal viewer ko GONE rakha jayega. -->
        <TextView
            android:id="@+id/storyLikeCount"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/story_viewer_chip"
            android:gravity="center"
            android:minWidth="75dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="0 Likes"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- VIEWERS PANEL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/viewersPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/story_viewers_panel_bg"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">

        <!-- HANDLE -->
        <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/story_handle" />

        <!-- TITLE -->
        <TextView
            android:id="@+id/viewersTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:text="Views 0"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- EMPTY -->
        <TextView
            android:id="@+id/emptyViewersText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="No views yet"
            android:textColor="#AAAAAA"
            android:textSize="14sp" />

        <!-- VIEWERS LIST -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/viewersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</FrameLayout>