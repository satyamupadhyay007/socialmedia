<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/storyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#000000">


    <!-- ================================================== -->
    <!-- STORY IMAGE -->
    <!-- ================================================== -->

    <ImageView
        android:id="@+id/storyImage"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:scaleType="fitCenter"

        android:contentDescription="Story image"

        android:visibility="gone" />


    <!-- ================================================== -->
    <!-- STORY VIDEO -->
    <!-- ================================================== -->

    <VideoView
        android:id="@+id/storyVideo"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:contentDescription="Story video"

        android:visibility="gone" />


    <!-- ================================================== -->
    <!-- TOP AREA -->
    <!-- ================================================== -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="80dp"

        android:orientation="vertical"

        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp">


        <ProgressBar
            android:id="@+id/storyProgress"

            android:layout_width="match_parent"
            android:layout_height="4dp"

            android:max="100"
            android:progress="0"

            style="?android:attr/progressBarStyleHorizontal" />


        <TextView
            android:id="@+id/storyUsername"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="9dp"

            android:text="User"

            android:textColor="#FFFFFF"

            android:textSize="15sp"

            android:textStyle="bold" />

    </LinearLayout>


    <!-- ================================================== -->
    <!-- CLOSE -->
    <!-- ================================================== -->

    <ImageButton
        android:id="@+id/btnCloseStory"

        android:layout_width="48dp"
        android:layout_height="48dp"

        android:layout_gravity="top|end"

        android:layout_marginTop="22dp"
        android:layout_marginEnd="8dp"

        android:background="@android:color/transparent"

        android:src="@android:drawable/ic_menu_close_clear_cancel"

        app:tint="#FFFFFF"

        android:contentDescription="Close story" />


    <!-- ================================================== -->
    <!-- BOTTOM STORY CONTROLS -->
    <!-- ================================================== -->

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_gravity="bottom"

        android:gravity="center_vertical"

        android:orientation="horizontal"

        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">


        <!-- VIEW COUNT -->

        <TextView
            android:id="@+id/storyViewCount"

            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_weight="1"

            android:text="👁 0"

            android:textColor="#FFFFFF"

            android:textSize="14sp"

            android:textStyle="bold" />


        <!-- LIKE -->

        <ImageButton
            android:id="@+id/btnLikeStory"

            android:layout_width="52dp"
            android:layout_height="52dp"

            android:background="@android:color/transparent"

            android:padding="8dp"

            android:src="@android:drawable/btn_star_big_off"

            app:tint="#FFFFFF"

            android:contentDescription="Like story" />

    </LinearLayout>


    <!-- ================================================== -->
    <!-- VIEWERS PANEL -->
    <!-- ================================================== -->

    <LinearLayout

        android:id="@+id/viewersPanel"

        android:layout_width="match_parent"

        android:layout_height="match_parent"

        android:layout_gravity="bottom"

        android:background="#F21F1F1F"

        android:elevation="12dp"

        android:orientation="vertical"

        android:visibility="gone">


        <!-- PANEL HEADER -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="60dp"

            android:gravity="center_vertical"

            android:orientation="horizontal"

            android:paddingStart="18dp"
            android:paddingEnd="18dp">


            <TextView
                android:id="@+id/viewersTitle"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Views 0"

                android:textColor="#FFFFFF"

                android:textSize="17sp"

                android:textStyle="bold" />


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Swipe down"

                android:textColor="#AAAAAA"

                android:textSize="11sp" />

        </LinearLayout>


        <!-- VIEWER LIST -->

        <ScrollView

            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:layout_weight="1"

            android:fillViewport="true">


            <LinearLayout
                android:id="@+id/viewersList"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical" />

        </ScrollView>


        <!-- EMPTY -->

        <TextView
            android:id="@+id/emptyViewersText"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:gravity="center"

            android:padding="20dp"

            android:text="No views yet"

            android:textColor="#AAAAAA"

            android:textSize="14sp"

            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>